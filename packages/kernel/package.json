{
  "name": "@exponetdb/kernel",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Smallest foundation: typed ids, Result, error classes, canonical JSON (RFC 8785), SHA-256, plan hash, clock.",
  "sideEffects": false,
  "exports": {
    ".": {
      "@exponetdb/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hash": {
      "@exponetdb/source": "./src/hash/index.ts",
      "types": "./dist/hash/index.d.ts",
      "default": "./dist/hash/index.js"
    },
    "./node": {
      "@exponetdb/source": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "zod": "4.6.6"
  }
}
