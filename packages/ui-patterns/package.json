{
  "name": "@exponetdb/ui-patterns",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Composites of the Web App: page layout, dialogs and the confirmation ladder, truthful state components, forms, filter bar, command menu, charts, badges. No Monaco, no virtualized grid, no router or telemetry import (design-system.md §1).",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@exponetdb/source": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@exponetdb/icons": "workspace:*",
    "@exponetdb/ui": "workspace:*",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "radix-ui": "1.6.7",
    "react-hook-form": "7.89.0",
    "recharts": "3.10.1",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/jest-dom": "7.0.1",
