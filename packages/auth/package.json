{
  "name": "@exponetdb/auth",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Identity, authentication and authorization of ExponetDB: identities, passkeys, password with TOTP, recovery codes, one-time links, Web sessions with CSRF protection, re-authentication, rate limits, the built-in RBAC, scope coverage and the central authorization engine, and the access operation kinds.",
  "sideEffects": false,
  "exports": {
    ".": {
      "@exponetdb/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@exponetdb/audit": "workspace:*",
    "@exponetdb/contracts": "workspace:*",
    "@exponetdb/control-store": "workspace:*",
    "@exponetdb/kernel": "workspace:*",
    "@exponetdb/operations": "workspace:*",
    "@exponetdb/policy": "workspace:*",
    "@exponetdb/secrets": "workspace:*",
    "@node-rs/argon2": "2.2.1",
    "@simplewebauthn/server": "14.0.3",
    "@zxcvbn-ts/language-common": "4.1.3",
    "otpauth": "9.5.2",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "fast-check": "4.10.2"
  }
}
