{
  "$comment": "Generated from packages/contracts by tooling/generators. Do not edit.",
  "$defs": {
    "ProjectConfig": {
      "additionalProperties": false,
      "description": "exponetdb.project.yaml at the root of a migration stream (strict).",
      "properties": {
        "bundleRoots": {
          "description": "Where the stream reads bundles in place (no copy step); default the directory of this file.",
          "items": {
            "description": "A directory of bundles, relative to exponetdb.project.yaml.",
            "maxLength": 512,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._\\-/]+$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        },
        "defaults": {
          "additionalProperties": false,
          "properties": {
            "lockTimeout": {
              "description": "Duration such as 5s, 10m, 1h30m or 250ms, between 1 ms and 6 h.",
              "minLength": 2,
              "pattern": "^(?:(0|[1-9][0-9]{0,8})h)?(?:(0|[1-9][0-9]{0,8})m)?(?:(0|[1-9][0-9]{0,8})s)?(?:(0|[1-9][0-9]{0,8})ms)?$",
              "type": "string"
            },
            "role": {
              "description": "Execution role alias defined in the project configuration.",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "type": "string"
            },
            "searchPath": {
              "items": {
                "description": "PostgreSQL schema name (1 to 63 bytes, no control characters).",
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 32,
              "type": "array"
            },
            "statementTimeout": {
              "description": "Duration such as 5s, 10m, 1h30m or 250ms, between 1 ms and 6 h.",
              "minLength": 2,
              "pattern": "^(?:(0|[1-9][0-9]{0,8})h)?(?:(0|[1-9][0-9]{0,8})m)?(?:(0|[1-9][0-9]{0,8})s)?(?:(0|[1-9][0-9]{0,8})ms)?$",
              "type": "string"
            }
          },
          "type": "object"
        },
        "executionRoles": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "propertyNames": {
            "description": "Execution role alias defined in the project configuration.",
            "pattern": "^[a-z][a-z0-9_]{0,62}$",
            "type": "string"
          },
          "type": "object"
        },
        "invariants": {
          "$ref": "#/$defs/ProjectInvariants"
        },
        "layout": {
          "enum": [
            "bundles",
            "legacy+bundles"
          ],
          "type": "string"
        },
        "legacy": {
          "additionalProperties": false,
          "properties": {
            "baseline": {
              "description": "Baseline node baseline:<slug>.",
              "maxLength": 73,
              "pattern": "^baseline:[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            },
            "directory": {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "directory",
            "baseline"
          ],
          "type": "object"
        },
        "lint": {
          "$ref": "#/$defs/ProjectLint"
        },
        "lintProfile": {
          "enum": [
            "strict",
            "standard"
          ],
          "type": "string"
        },
        "managedScope": {
          "additionalProperties": false,
          "properties": {
            "excludeSchemas": {
              "items": {
                "description": "PostgreSQL schema name (1 to 63 bytes, no control characters).",
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 256,
              "type": "array"
            },
            "includeSchemas": {
              "anyOf": [
                {
                  "const": "*",
                  "type": "string"
                },
                {
                  "items": {
                    "description": "PostgreSQL schema name (1 to 63 bytes, no control characters).",
                    "minLength": 1,
                    "type": "string"
                  },
                  "maxItems": 256,
                  "minItems": 1,
                  "type": "array"
                }
              ]
            }
          },
          "required": [
            "includeSchemas",
            "excludeSchemas"
          ],
          "type": "object"
        },
        "project": {
          "description": "<product>/<project>; must match the registry.",
          "pattern": "^[a-z][a-z0-9-]{0,38}\\/[a-z][a-z0-9-]{0,38}$",
          "type": "string"
        },
        "schema": {
          "const": "exponetdb.project/v1",
          "type": "string"
        },
        "trustedExtensions": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
            "type": "string"
          },
          "maxItems": 64,
          "type": "array"
        }
      },
      "required": [
        "schema",
        "project",
        "layout",
        "executionRoles",
        "managedScope",
        "lintProfile"
      ],
      "title": "exponetdb.project/v1",
      "type": "object"
    },
    "ProjectInvariants": {
      "additionalProperties": false,
      "properties": {
        "grantRequired": {
          "description": "Schemas whose new tables must receive an explicit GRANT in the same migration.",
          "items": {
            "description": "PostgreSQL schema name (1 to 63 bytes, no control characters).",
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "rowSecurityRequired": {
          "description": "Schemas whose new tables must enable row level security in the same migration.",
          "items": {
            "description": "PostgreSQL schema name (1 to 63 bytes, no control characters).",
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        }
      },
      "type": "object"
    },
    "ProjectLint": {
      "additionalProperties": false,
      "properties": {
        "forbiddenFunctions": {
          "items": {
            "maxLength": 127,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "forbiddenSchemas": {
          "items": {
            "description": "PostgreSQL schema name (1 to 63 bytes, no control characters).",
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "type": "array"
        },
        "rules": {
          "additionalProperties": {
            "enum": [
              "error",
              "warn",
              "info",
              "off"
            ],
            "type": "string"
          },
          "description": "Per-rule level overrides. Rules the engine enforces (forbidden statements, DAG errors, non-transactional statements in a transactional bundle) cannot be lowered; a lowered rule of a prod-tier project is shown in every plan.",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "type": "object"
        },
        "sizeThreshold": {
          "additionalProperties": false,
          "description": "A table is non-trivial above this heap size or row estimate (default 64 MiB, 1 million rows).",
          "properties": {
            "bytes": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "rows": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "$id": "https://db.exponet.cloud/schemas/project-config/v1",
  "$ref": "#/$defs/ProjectConfig",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
