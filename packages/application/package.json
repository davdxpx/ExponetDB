{
  "name": "@exponetdb/application",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Use cases of ExponetDB: the only layer interfaces (REST, Web App ceremonies, MCP, CLI) call. Authorization through the central engine, then the domain services, in one Control Store transaction.",
  "sideEffects": false,
  "exports": {
    ".": {
      "@exponetdb/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@exponetdb/auth": "workspace:*",
    "@exponetdb/contracts": "workspace:*",
    "@exponetdb/control-store": "workspace:*",
    "@exponetdb/kernel": "workspace:*",
    "@exponetdb/operations": "workspace:*",
    "@exponetdb/policy": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.1"
  }
}
