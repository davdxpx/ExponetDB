{
  "name": "@exponetdb/tokens",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Design tokens of the Web App: OKLCH inputs, semantic CSS variables, light and dark themes, chart slots, the Tailwind v4 theme mapping, self-hosted fonts and utilities. CSS only, no components (design-system.md \u00a71).",
