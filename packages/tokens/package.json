    "./semantic.css": "./src/semantic.css",
    "./theme.css": "./src/theme.css",
    "./animations.css": "./src/animations.css",
    "./utilities.css": "./src/utilities.css",
    "./base.css": "./src/base.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
