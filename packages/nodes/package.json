{
  "name": "@exponetdb/nodes",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Node agent control plane: the fixed-profile certificate encoder, enrollment tokens and binding, job building, signing and sealing, result verification.",
  "sideEffects": false,
  "exports": {
    ".": {
      "@exponetdb/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@exponetdb/audit": "workspace:*",
    "@exponetdb/contracts": "workspace:*",
    "@exponetdb/control-store": "workspace:*",
    "@exponetdb/kernel": "workspace:*",
    "@exponetdb/operations": "workspace:*",
    "@exponetdb/secrets": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.1"
  }
}
