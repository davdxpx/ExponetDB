{
  "name": "@exponetdb/secrets",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Envelope encryption of secrets: the keyring, per-secret data keys under AES-256-GCM, context-bound associated data, consumer-separated ciphertext tables and master key rotation.",
  "sideEffects": false,
  "exports": {
    ".": {
      "@exponetdb/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@exponetdb/control-store": "workspace:*",
    "@exponetdb/kernel": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "fast-check": "4.10.2"
  }
}
