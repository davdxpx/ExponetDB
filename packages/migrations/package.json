{
  "name": "@exponetdb/migrations",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Migration domain. Wave 1 ships only the pure format subpath (manifest, c1, digests, ls1).",
  "sideEffects": false,
  "exports": {
    "./format": {
      "@exponetdb/source": "./src/format/index.ts",
      "types": "./dist/format/index.d.ts",
      "default": "./dist/format/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@exponetdb/contracts": "workspace:*",
    "@exponetdb/kernel": "workspace:*",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "zod": "4.6.5"
  }
}
