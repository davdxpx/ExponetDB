{
  "name": "@exponetdb/ui",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Primitives of the Web App on Radix and class-variance-authority, adopted from Supabase's packages/ui under ADR-0030. No data fetching, routing or app state (design-system.md \u00a71).",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@exponetdb/source": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./csp.css": "./src/csp.css",
    "./vite": {
      "@exponetdb/source": "./build/csp-vite-plugin.ts",
      "default": "./build/csp-vite-plugin.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@exponetdb/icons": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "input-otp": "1.5.0",
    "radix-ui": "1.6.7",
    "react-accessible-treeview": "2.11.2",
    "react-day-picker": "9.14.0",
    "react-hook-form": "7.89.0",
    "react-resizable-panels": "4.14.1",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.7",
    "jsdom": "30.1.1",
    "axe-core": "4.13.0",
    "vite": "8.3.3"
  }
}
