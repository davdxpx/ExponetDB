{
  "name": "@exponetdb/ui-data",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Data components of the Web App: data grid, SQL editor and diff, plan, EXPLAIN and schema diff viewers, schema tree and ERD, migration timeline. Heavy parts load lazily; no domain logic (design-system.md §1).",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@exponetdb/source": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./grid/data-grid": {
      "@exponetdb/source": "./src/grid/data-grid.tsx",
      "default": "./src/grid/data-grid.tsx"
    },
    "./editor/sql-editor": {
      "@exponetdb/source": "./src/editor/sql-editor.tsx",
      "default": "./src/editor/sql-editor.tsx"
    },
    "./editor/text-diff": {
      "@exponetdb/source": "./src/editor/text-diff.tsx",
      "default": "./src/editor/text-diff.tsx"
    },
    "./erd/schema-erd": {
      "@exponetdb/source": "./src/erd/schema-erd.tsx",
      "default": "./src/erd/schema-erd.tsx"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@dagrejs/dagre": "3.1.1",
    "@exponetdb/icons": "workspace:*",
    "@exponetdb/ui": "workspace:*",
    "@exponetdb/ui-patterns": "workspace:*",
    "@lezer/highlight": "1.2.5",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.13",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.7",
    "jsdom": "30.1.1",
    "axe-core": "4.13.0"
  }
}
