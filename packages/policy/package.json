{
  "name": "@exponetdb/policy",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "The Policy Engine framework: rules, fact providers, deterministic evaluation and combination, scoped configuration and the pv1 policy version.",
