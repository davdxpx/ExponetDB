  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@exponetdb/contracts": "workspace:*",
    "@exponetdb/kernel": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "fast-check": "4.10.2"
  }
}
