        "control-store",
        "secrets",
        "audit",
        "postgres",
        "operations",
        "policy",
        "testkit"
      ]
    },
    "registry": {
      "path": "^packages/registry/",
      "allowed": [
        "contracts",
        "control-store",
        "secrets",
