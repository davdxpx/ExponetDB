{
  "$comment": "Allowed dependencies between components, transcribed from exponetdb-docs/01-architecture/package-architecture.md \u00a72 (arrows point from consumer to dependency). Foundations (kernel, contracts) are also allowed wherever they are reachable through allowed edges. Everything else is forbidden. Components that do not exist yet are modeled so the rules apply from their first commit.",
  "foundations": ["kernel", "contracts"],
  "components": {
    "kernel": {
      "path": "^packages/kernel/",
      "allowed": []
    },
    "contracts": {
      "path": "^packages/contracts/",
      "allowed": ["kernel"]
    },
    "observability": {
      "path": "^packages/observability/",
      "allowed": ["kernel"]
    },
    "control-store": {
      "path": "^packages/control-store/",
      "allowed": [
        "kernel",
        "observability",
        "migrations/format",
        "migrations/graph",
        "migrations/lint"
      ]
    },
    "migrations/format": {
      "path": "^packages/migrations/src/format/",
      "allowed": ["kernel", "contracts"]
    },
    "migrations/graph": {
      "path": "^packages/migrations/src/graph/",
      "allowed": ["kernel", "contracts", "migrations/format"]
    },
    "migrations/lint": {
      "path": "^packages/migrations/src/lint/",
      "allowed": ["kernel", "contracts", "migrations/format", "migrations/graph", "postgres/parser"]
    },
    "migrations/engine": {
      "path": "^packages/migrations-engine/src/",
      "allowed": [
        "migrations/format",
        "migrations/graph",
        "migrations/lint",
        "operations",
        "registry",
        "postgres",
        "postgres/parser",
        "control-store",
        "audit",
        "policy"
      ]
    },
    "migrations-engine/test": {
      "path": "^packages/migrations-engine/test/",
      "allowed": [
        "migrations/engine",
        "migrations/format",
        "migrations/graph",
        "migrations/lint",
        "registry",
        "registry/test",
        "operations",
        "policy",
        "control-store",
        "audit",
        "secrets",
        "postgres",
        "postgres/parser",
        "testkit",
        "kernel",
        "contracts"
      ]
    },
    "migrations/test": {
      "path": "^packages/migrations/test/",
      "allowed": [
        "migrations/format",
        "migrations/graph",
        "migrations/lint",
        "migrations/engine",
        "kernel",
        "contracts"
      ]
    },
    "secrets": {
      "path": "^packages/secrets/",
      "allowed": ["kernel", "control-store"]
    },
    "audit": {
      "path": "^packages/audit/",
      "allowed": ["contracts", "control-store"]
    },
    "postgres/parser": {
      "path": "^packages/postgres/src/parser/",
      "allowed": ["kernel", "contracts", "observability"]
    },
    "postgres/test": {
      "path": "^packages/postgres/test/",
      "allowed": ["postgres", "postgres/parser", "testkit", "kernel", "contracts", "observability"]
    },
    "postgres": {
      "path": "^packages/postgres/",
      "allowed": ["kernel", "contracts", "observability", "postgres/parser"]
    },
    "testkit": {
      "path": "^packages/testkit/",
      "allowed": ["kernel"]
    },
    "policy": {
      "path": "^packages/policy/",
      "allowed": ["kernel", "contracts"]
    },
    "auth": {
      "path": "^packages/auth/",
      "allowed": ["contracts", "control-store", "secrets", "audit", "policy", "operations"]
    },
    "registry/test": {
      "path": "^packages/registry/test/",
      "allowed": [
        "registry",
