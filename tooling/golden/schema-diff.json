      "id": "diff-001",
      "description": "the same document: everything matched",
      "input": {
        "left": "fp1-005",
        "right": "fp1-005"
      },
      "expected": {
        "comparable": true,
        "added": [],
        "removed": [],
        "changed": [],
        "documentationChanged": [],
        "matched": 49
      }
    },
