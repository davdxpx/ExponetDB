{
  "contract": "ls1 ledger state hash",
  "specification": "exponetdb-docs/04-migrations/ledger.md#3-derived-values",
  "notes": "entries are ledger rows (reverted = reverted_at IS NOT NULL); baselineId is ledger_meta.baseline_id or null. expected.hashInput is the exact UTF-8 text that is hashed.",
  "vectors": [
    {
      "id": "ls1-001",
      "description": "empty ledger without a baseline",
      "entries": [],
      "baselineId": null,
      "expected": {
        "hashInput": "baseline -\n",
