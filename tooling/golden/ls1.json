      }
    },
    {
      "id": "ls1-002",
      "description": "empty ledger with a baseline id",
      "entries": [],
      "baselineId": "baseline:demo-app-2026-10",
      "expected": {
        "hashInput": "baseline baseline:demo-app-2026-10\n",
        "ledgerStateHash": "sha256:ls1:95d398a2d053ea17a2780b7c48d55d2dc8ebe663d25c2ac2105ddf924b0dda96"
      }
    },
    {
