{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "package.json", "tsconfig.build.json", "../../tsconfig.base.json"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "inputs": ["src/**", "test/**", "package.json", "tsconfig.json", "../../tsconfig.base.json"],
      "outputs": []
    },
    "test": {
      "inputs": [
        "src/**",
        "test/**",
        "package.json",
        "vitest.config.ts",
        "../../vitest.shared.ts",
        "../../tooling/golden/**",
        "migrations/**"
      ],
      "outputs": []
    },
    "test:integration": {
      "cache": false,
      "env": ["EXDB_TEST_PG_URL"],
      "inputs": [
        "src/**",
        "test/**",
        "migrations/**",
        "package.json",
        "vitest.integration.config.ts",
        "../../vitest.shared.ts"
      ],
      "outputs": []
    }
  },
  "agentGuidance": false
}
