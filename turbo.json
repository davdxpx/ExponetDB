{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "package.json", "tsconfig.build.json", "../../tsconfig.base.json"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "inputs": [
        "src/**",
        "test/**",
        "package.json",
        "tsconfig.json",
        "../../tsconfig.base.json",
        "../../tsconfig.react.json",
        "../../vitest.dom-setup.ts",
        "vite.config.ts",
        "vitest.config.ts"
      ],
      "outputs": []
    },
    "test": {
      "inputs": [
        "src/**",
        "test/**",
        "package.json",
        "vitest.config.ts",
        "../../vitest.shared.ts",
        "../../tooling/golden/**",
        "migrations/**",
        "../../vitest.dom-setup.ts"
      ],
      "outputs": []
    },
    "test:integration": {
      "cache": false,
      "env": [
        "EXDB_TEST_PG_URL",
        "EXDB_TEST_TARGETS",
        "EXDB_TEST_S3_ENDPOINT",
        "EXDB_TEST_S3_ACCESS_KEY",
        "EXDB_TEST_S3_SECRET_KEY"
      ],
      "inputs": [
        "src/**",
        "test/**",
        "migrations/**",
        "package.json",
        "vitest.integration.config.ts",
        "../../vitest.shared.ts"
      ],
      "outputs": []
    }
  },
  "agentGuidance": false
}
