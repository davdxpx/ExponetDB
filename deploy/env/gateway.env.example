# ExponetDB `gateway` (Coolify application, command: gateway). Placeholders
# only. No agent listener before Wave 5: EXPONETDB_GATEWAY_LISTEN is refused.
#
# Control Store URL of the login exdb_gateway. Secret.
EXPONETDB_CONTROL_STORE_URL=
EXPONETDB_INSTALLATION_ID=
# Secret.
EXPONETDB_KEYRING=
EXPONETDB_ROLE=gateway
EXPONETDB_INTERNAL_LISTEN=127.0.0.1:9464
EXPONETDB_LOG_LEVEL=info
