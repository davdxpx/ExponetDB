# ExponetDB Control Store migration (one-shot Coolify resource, command:
# control-store migrate), run before rolling out the roles. Placeholders only.
#
# Control Store URL of the login exdb_migrate (the only login with DDL on the
# ExponetDB schemas; no process role holds it). Secret.
EXPONETDB_CONTROL_STORE_URL=
EXPONETDB_LOG_LEVEL=info
