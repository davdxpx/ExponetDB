# ExponetDB `worker` (Coolify application, command: worker). Placeholders only.
#
# Control Store URL of the login exdb_worker. Secret.
EXPONETDB_CONTROL_STORE_URL=
EXPONETDB_INSTALLATION_ID=
# Secret.
EXPONETDB_KEYRING=
EXPONETDB_ROLE=worker
EXPONETDB_INTERNAL_LISTEN=127.0.0.1:9464
EXPONETDB_LOG_LEVEL=info
# Off-host export of audit checkpoints (audit.md §4.4): an S3-compatible
# bucket with object lock. Without it, worker readiness is degraded.
EXPONETDB_AUDIT_S3_ENDPOINT=https://fsn1.your-objectstorage.com
EXPONETDB_AUDIT_S3_REGION=fsn1
EXPONETDB_AUDIT_S3_BUCKET=
EXPONETDB_AUDIT_S3_PREFIX=exponetdb
# Secret pair, an access key limited to this bucket.
EXPONETDB_AUDIT_S3_ACCESS_KEY_ID=
EXPONETDB_AUDIT_S3_SECRET_ACCESS_KEY=
EXPONETDB_AUDIT_S3_OBJECT_LOCK_MODE=COMPLIANCE
EXPONETDB_AUDIT_S3_OBJECT_LOCK_DAYS=3650
# Wave 9 Part B: backup and restore runs stay off until an operator turns them on
# (backups: disabled|nonprod|all; restores: disabled|scratch|all). Same value on serve and worker.
EXPONETDB_BACKUP_EXECUTION=disabled
EXPONETDB_RESTORE_EXECUTION=disabled
