# ExponetDB `serve` (Coolify application, command: serve). Placeholders only:
# the values live in Coolify, never in the repository.
#
# Control Store URL of the login exdb_serve (scheme postgres, host
# exponetdb-control, port 5432, database exponetdb_control), password from the
# bootstrap credentials file. Secret.
EXPONETDB_CONTROL_STORE_URL=
# Printed by the first `exponetdb control-store migrate`.
EXPONETDB_INSTALLATION_ID=
# The keyring JSON (exponetdb.keyring/v1). Secret. Alternatively
# EXPONETDB_KEYRING_FILE with a mounted file readable only by uid 1000.
EXPONETDB_KEYRING=
EXPONETDB_ROLE=serve
EXPONETDB_LISTEN=0.0.0.0:8080
# The public origin (scheme and host only): the Web App, the /auth ceremonies,
# the exact Origin check and the WebAuthn origin. Required since Wave 3A.
EXPONETDB_PUBLIC_URL=https://db.exponet.cloud
# Optional WebAuthn RP ID: the host of EXPONETDB_PUBLIC_URL (default) or a
# parent domain of it. Changing it later invalidates every registered passkey.
EXPONETDB_WEBAUTHN_RP_ID=db.exponet.cloud
# Optional: addresses or CIDRs of the reverse proxies whose X-Forwarded-For is
# believed (comma separated, at most 16). Empty: the peer address is used.
EXPONETDB_TRUSTED_PROXIES=
# Optional (Wave 7): further exact HTTPS origins of browser-based MCP clients
# allowed to call /mcp (comma separated, at most 8). Empty: the public origin only.
EXPONETDB_MCP_ALLOWED_ORIGINS=
# Optional: how new MCP clients are admitted. open (default): approved
# automatically, every person still consents; review: an administrator
# approves each new client on Admin → Clients first.
EXPONETDB_OAUTH_CLIENT_REGISTRATION=open
EXPONETDB_INTERNAL_LISTEN=127.0.0.1:9464
EXPONETDB_LOG_LEVEL=info
# Wave 9 Part B: backup and restore runs stay off until an operator turns them on
# (backups: disabled|nonprod|all; restores: disabled|scratch|all). Same value on serve and worker.
EXPONETDB_BACKUP_EXECUTION=disabled
EXPONETDB_RESTORE_EXECUTION=disabled
