# The node agent (architecture.md §1): unprivileged, network-facing, no
# capabilities. It talks to the gateway over HTTP/2 mTLS, to PostgreSQL over
# the local socket (peer authentication as exponetdb_node), and to the root
# helper over its socket. Installed by the operator; never enabled before the
# host is enrolled (exponetdb-docs/12-operations/node-runbook.md).
[Unit]
Description=ExponetDB node agent
Documentation=file:///usr/share/doc/exponetdb-node/node-runbook.md
Wants=network-online.target
After=network-online.target exponetdb-node-helper.socket postgresql.service
Requires=exponetdb-node-helper.socket

[Service]
Type=simple
User=exponetdb-node
Group=exponetdb-node
ExecStart=/usr/bin/exponetdb-node run --config /etc/exponetdb-node/config.json
Restart=on-failure
RestartSec=5s
# A running job finishes or is reported interrupted; a stop never waits long.
TimeoutStopSec=30s
StateDirectory=exponetdb-node
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# The clock guard reads the kernel's synchronization state (adjtimex with no
# modes); without CAP_SYS_TIME the call cannot change the clock.
SystemCallFilter=adjtimex
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
