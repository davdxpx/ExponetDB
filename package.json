{
  "name": "exponetdb",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24.0.0 <25",
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=2",
    "test:e2e": "bun run --cwd apps/web build && turbo run build --filter=@exponetdb/cli && bun run --cwd apps/server test:e2e",
    "dev:control-store": "bash tooling/dev/control-store.sh",
    "dev:targets": "bash tooling/dev/targets.sh",
    "check": "biome check .",
    "format": "biome check --write .",
    "generate": "bun --conditions=@exponetdb/source tooling/generators/generate.ts",
    "verify:generated": "bun --conditions=@exponetdb/source tooling/generators/generate.ts --check",
    "boundaries": "bun --conditions=@exponetdb/source tooling/boundaries/check.ts",
    "secrets": "bun --conditions=@exponetdb/source tooling/checks/secrets.ts",
    "third-party": "bun --conditions=@exponetdb/source tooling/checks/third-party.ts",
    "licenses": "bun --conditions=@exponetdb/source tooling/checks/licenses.ts",
    "ui-safety": "bun --conditions=@exponetdb/source tooling/checks/ui-safety.ts",
    "go:test": "cd agent/node && go vet ./... && go test -race -count=1 ./...",
    "smoke:image": "docker build -t exponetdb:local . && bash tooling/smoke/roles.sh exponetdb:local",
    "verify": "bun run check && bun run typecheck && bun run test && bun run test:integration && bun run test:e2e && bun run --cwd apps/server test:conformance && bun run build && bun run verify:generated && bun run golden:check && bun run golden:history origin/main && bun run golden:history 6e556f6b5a26ba141f600d38f612134af3600e49 && bun run boundaries && bun run secrets && bun run third-party && bun run licenses && bun run ui-safety && bun run go:test",
    "golden:check": "bun --conditions=@exponetdb/source tooling/checks/golden-lock.ts",
    "golden:history": "bun --conditions=@exponetdb/source tooling/checks/golden-history.ts",
    "golden:lock": "bun --conditions=@exponetdb/source tooling/checks/golden-lock.ts --append",
    "mcp:conformance": "bun run --cwd apps/server test:conformance mcp-conformance",
    "mcp:inspect": "bun run --cwd apps/server test:conformance mcp-inspector",
    "mcp:evals": "bun run --cwd apps/server test:evals"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.1",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
