{
  "name": "@exponetdb/server",
  "version": "0.2.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "The ExponetDB Control Plane process: one program, three roles (serve, worker, gateway) and the operator commands.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bundle": "bun scripts/bundle.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@exponetdb/application": "workspace:*",
    "@exponetdb/audit": "workspace:*",
    "@exponetdb/auth": "workspace:*",
    "@exponetdb/contracts": "workspace:*",
    "@exponetdb/control-store": "workspace:*",
    "@exponetdb/diagnostics": "workspace:*",
    "@exponetdb/kernel": "workspace:*",
    "@exponetdb/observability": "workspace:*",
    "@exponetdb/operations": "workspace:*",
    "@exponetdb/policy": "workspace:*",
    "@exponetdb/postgres": "workspace:*",
    "@exponetdb/registry": "workspace:*",
    "@exponetdb/secrets": "workspace:*",
    "@hono/node-server": "2.1.3",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@exponetdb/testkit": "workspace:*",
    "@types/node": "24.19.1",
    "oauth4webapi": "3.8.8",
    "otpauth": "9.5.2",
    "playwright-core": "1.56.1"
  }
}
